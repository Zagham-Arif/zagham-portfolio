{
  "name": "zagham-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portfolio of a senior full-stack engineer, built with Next.js 16, React 19, TypeScript, Tailwind CSS 4 and next-intl",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-all": "yarn type-check && yarn check-i18n && yarn lint && yarn test && yarn format:check",
    "check-i18n": "node scripts/check-i18n-keys.mjs",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "next": "16",
    "next-intl": "^4.15.1",
    "next-themes": "^0.4.6",
    "react": "19",
    "react-dom": "19",
    "simple-icons": "^16.37.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "eslint": "9",
    "eslint-config-next": "16",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "postcss": "^8",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4",
    "typescript": "^5"
  }
}
